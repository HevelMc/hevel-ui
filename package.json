{
  "name": "hevel-ui",
  "author": {
    "name": "alopez",
    "email": "dev@alopez.fr"
  },
  "type": "module",
  "description": "Hevel UI is a collection of Svelte components for building web applications.",
  "license": "MIT",
  "version": "1.0.0-next.8",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HevelMc/hevel-ui.git"
  },
  "scripts": {
    "dev": "vite dev --port 5189",
    "build": "vite build && npm run package",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "svelte": "^5.0.0"
  },
  "dependencies": {
    "@internationalized/date": "^3.5.6",
    "@tanstack/table-core": "^8.20.5",
    "bits-ui": "^1.0.0-next.26",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "embla-carousel-autoplay": "8.1.6",
    "embla-carousel-svelte": "^8.3.0",
    "formsnap": "2.0.0-next.0",
    "lucide-svelte": "^0.453.0",
    "mode-watcher": "^0.4.1",
    "nanoid": "^5.0.7",
    "paneforge": "1.0.0-next.1",
    "runed": "^0.15.2",
    "svelte-check": "^4.0.0",
    "svelte-local-storage-store": "^0.6.4",
    "svelte-persisted-store": "^0.11.0",
    "svelte-preprocess": "^6.0.3",
    "svelte-sonner": "^0.3.27",
    "sveltekit-superforms": "^2.16.0",
    "tailwind-merge": "^2.5.3",
    "tailwind-variants": "^0.2.1",
    "tailwindcss": "^3.4.9",
    "tailwindcss-animate": "^1.0.7",
    "vaul-svelte": "1.0.0-next.0",
    "vite": "^5.0.11",
    "zod": "^3.23.8",
    "svelte-toolbelt": "0.4.4",
    "svelte": "^5.1.2"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "^3.3.0",
    "@sveltejs/kit": "^2.7.2",
    "@sveltejs/package": "2.3.5",
    "@sveltejs/vite-plugin-svelte": "^4.0.0",
    "@tailwindcss/typography": "^0.5.14",
    "@types/eslint": "^9.6.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte": "^2.46.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "prettier-plugin-svelte": "^3.2.7",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "publint": "^0.2.12",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
