{
  "name": "hevel-ui",
  "author": {
    "name": "alopez",
    "email": "dev@alopez.fr"
  },
  "type": "module",
  "description": "Hevel UI is a collection of Svelte components for building web applications.",
  "license": "MIT",
  "version": "1.0.0-next.14",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HevelMc/hevel-ui.git"
  },
  "scripts": {
    "dev": "vite dev --port 5189",
    "build": "vite build && npm run package",
    "build:standalone": "vite build",
    "preview": "vite preview",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "peerDependencies": {
    "@sveltejs/kit": "^2.16.1",
    "svelte": "^5.19.1"
  },
  "dependencies": {
    "@internationalized/date": "^3.7.0",
    "@lucide/svelte": "^0.511.0",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/table-core": "^8.20.5",
    "bits-ui": "1.7.0",
    "clsx": "^2.1.1",
    "d3-scale": "^4.0.2",
    "embla-carousel-autoplay": "^8.1.6",
    "embla-carousel-svelte": "^8.6.0",
    "formsnap": "2.0.1",
    "lucide-svelte": "^0.453.0",
    "mode-watcher": "^1.0.7",
    "paneforge": "1.0.0-next.5",
    "rehype-external-links": "^3.0.0",
    "runed": "^0.25.0",
    "shiki": "^2.1.0",
    "svelte": "^5.19.1",
    "svelte-check": "^4.1.4",
    "svelte-local-storage-store": "^0.6.4",
    "svelte-persisted-store": "^0.11.0",
    "svelte-preprocess": "^6.0.3",
    "svelte-sonner": "^1.0.3",
    "svelte-toolbelt": "0.4.4",
    "sveltekit-superforms": "^2.23.1",
    "tailwind-merge": "^3.3.0",
    "tailwind-variants": "^0.2.1",
    "layerchart": "2.0.0-next.10",
